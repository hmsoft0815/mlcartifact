{
  "name": "@hmsoft0815/mlcartifact-client",
  "version": "1.3.0",
  "description": "Universal TypeScript client for mlcartifact using Connect RPC",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "generate": "buf generate",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run generate",
    "build": "tsc",
    "pretest": "npm run generate",
    "test": "vitest run",
    "prepare": "npm run build",
    "example": "node --import tsx examples/example.ts"
  },
  "keywords": [
    "mcp",
    "artifact",
    "grpc",
    "connect-rpc",
    "universal"
  ],
  "author": "Michael Lechner",
  "license": "MIT",
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.de.md"
  ],
  "engines": {
    "node": ">=20"
  }
}
